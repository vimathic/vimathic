# engine-strict makes package.json's "engines" a refusal rather than a warning.
#
# Without it npm prints a notice and installs anyway, and the notice scrolls past
# in the same output as the install. The floor it enforces is 22.18, below which
# `npm test` used to spawn nothing and exit 0 — so the failure this prevents is
# not a broken install, it is a suite that reports a green run it never had.
engine-strict=true
